# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Environment / secrets
.env
.streamlit/secrets.toml

# Data
# student-mat.csv IS tracked: it is 57 KB, licensed CC BY 4.0 (UCI), and the deployed dashboard
# reads it. Processed arrays are regenerated by `python main.py prepare`, so they are not tracked.
data/raw/*
!data/raw/.gitkeep
!data/raw/student-mat.csv
data/processed/*
!data/processed/.gitkeep

# Results that are regenerated by the pipeline
# results/models, results/reports and results/figures ARE tracked: they are small (< 1 MB)
# and let the dashboard run on a fresh clone without re-training.
results/logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
