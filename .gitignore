# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Environment / secrets
.env
.streamlit/secrets.toml

# Data
# Raw dataset is downloaded by the user (see README). Processed arrays are regenerated by
# `python -m src.experiments.prepare_data`, so neither is tracked.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results that are regenerated by the pipeline
# results/models, results/reports and results/figures ARE tracked: they are small (< 1 MB)
# and let the dashboard run on a fresh clone without re-training.
results/logs/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
